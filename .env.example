# Copy this file to .env and fill in your values
# cp .env.example .env

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Root credentials for the MongoDB container (REQUIRED)
MONGO_ROOT_USERNAME=aitp
MONGO_ROOT_PASSWORD=changeme_strong_password

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Bootstrap admin credentials for Keycloak (REQUIRED)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_strong_password

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Endpoint URL for your Azure AI Foundry deployment
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# API key for authentication
AZURE_OPENAI_API_KEY=your-api-key-here
# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Deployment name (the model deployment in Azure AI Foundry)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── LLM Generation Parameters ────────────────────────────────────────────────
LLM_TEMPERATURE=0
LLM_TOP_P=1
LLM_MAX_TOKENS=8192

# ── Git Integration (optional — only needed for push/PR features) ─────────────
# GitHub personal access token
GITHUB_TOKEN=ghp_your_token_here
# GitLab personal access token
GITLAB_TOKEN=glpat-your_token_here
# Azure DevOps personal access token
AZURE_DEVOPS_TOKEN=your_ado_token_here
# Azure DevOps organization name
AZURE_DEVOPS_ORG=your_org_name
